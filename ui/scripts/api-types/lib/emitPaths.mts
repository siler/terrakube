// The pure paths emitter: the generated API_SCHEMA in, the typed `api`, `fields` and filter tables out. Each value
// is written out per type so tsc checks it against the mapped types the query layer declares.

/** One relationship as API_SCHEMA declares it. */
export type SchemaRelationship = { readonly type: string; readonly many: boolean; readonly required: boolean };

/** One type as API_SCHEMA declares it. */
export type SchemaType = {
  readonly root: boolean;
  readonly attributes: readonly string[];
  readonly relationships: Readonly<Record<string, SchemaRelationship>>;
};

const camel = (typeName: string): string =>
  typeName.replace(/[^A-Za-z0-9]+(.)?/g, (_, next: string | undefined) => (next ?? "").toUpperCase());

const nodeName = (typeName: string): string => `${camel(typeName)}Node`;

const attributesName = (typeName: string): string => `${camel(typeName)}Attributes`;

const key = (name: string): string => (/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name) ? name : JSON.stringify(name));

const attributeFilters = (typeName: string, type: SchemaType): string => {
  const entries = type.attributes.map((name) => `    ${key(name)}: comparisons(root, \`\${prefix}${name}\`),`);
  return [
    `function ${attributesName(typeName)}<R extends ApiTypeName>(root: R, prefix: string): AttributeFilters<R, ${JSON.stringify(typeName)}> {`,
    // A named object skips the excess-property check, so list and map attributes keep their (unused) comparisons.
    "  const paths = {",
    ...entries,
    "  };",
    "  return paths;",
    "}",
  ].join("\n");
};

const relationshipPath = (name: string, relationship: SchemaRelationship): string => {
  const builder = relationship.many ? "toMany" : relationship.required ? "requiredOne" : "optionalOne";
  return `    ${key(name)}: ${builder}(${nodeName(relationship.type)}, \`\${path}/${name}\`),`;
};

const relationshipFilter = (typeName: string, name: string, relationship: SchemaRelationship): string =>
  `    ${key(name)}: { ...${attributesName(relationship.type)}(${JSON.stringify(typeName)}, ${JSON.stringify(`${name}.`)}), id: comparisons(${JSON.stringify(typeName)}, ${JSON.stringify(`${name}.id`)}) },`;

const typeNode = (typeName: string, type: SchemaType): string => {
  const relationships = Object.entries(type.relationships);
  const quoted = JSON.stringify(typeName);
  return [
    `const ${nodeName(typeName)}: TypeNode<${quoted}> = {`,
    `  type: ${quoted},`,
    relationships.length > 0
      ? [
          "  relationships: (path) => ({",
          ...relationships.map(([name, rel]) => relationshipPath(name, rel)),
          "  }),",
        ].join("\n")
      : "  relationships: () => ({}),",
    "  filters: once(() => ({",
    `    ...${attributesName(typeName)}(${quoted}, ""),`,
    `    id: comparisons(${quoted}, "id"),`,
    ...relationships.map(([name, rel]) => relationshipFilter(typeName, name, rel)),
    "  })),",
    "};",
  ].join("\n");
};

const allSelection = (type: SchemaType): string => {
  const attributes = type.attributes.map((name) => JSON.stringify(name));
  const relationships = Object.keys(type.relationships);
  const linkage =
    relationships.length > 0 ? [`{ ${relationships.map((name) => `${key(name)}: ids`).join(", ")} }`] : [];
  return `[${[...attributes, ...linkage].join(", ")}]`;
};

export const generatePaths = (schema: Readonly<Record<string, SchemaType>>): string => {
  const types = Object.entries(schema).sort(([a], [b]) => a.localeCompare(b));
  return [
    "// Generated by ui/scripts/api-types/paths.mts from API_SCHEMA in apiResources.ts. Do not edit.",
    "",
    'import type { ApiTypeName } from "./apiResources";',
    'import { comparisons, filterWith, once, type AttributeFilters, type Filter, type FilterPaths } from "../api/filter";',
    'import { optionalOne, requiredOne, toMany, type Api, type TypeNode } from "../api/query";',
    'import { fragmentBuilder, ids, type Fields } from "../api/selection";',
    "",
    ...types.map(([name, type]) => attributeFilters(name, type)),
    "",
    ...types.map(([name, type]) => typeNode(name, type)),
    "",
    "const NODES: { readonly [N in ApiTypeName]: TypeNode<N> } = {",
    ...types.map(([name]) => `  ${key(name)}: ${nodeName(name)},`),
    "};",
    "",
    "/** The API's resources as paths, checked against the generated schema; awaiting a selected path sends one GET. */",
    "export const api: Api = {",
    ...types
      .filter(([, type]) => type.root)
      .map(([name]) => `  ${key(name)}: toMany(${nodeName(name)}, ${JSON.stringify(name)}),`),
    "};",
    "",
    "/** Builds fragments from the generated schema, so a field the API does not serve fails to compile. */",
    "export const fields: Fields = {",
    ...types.map(([name, type]) => `  ${key(name)}: fragmentBuilder(${JSON.stringify(name)}, ${allSelection(type)}),`),
    "};",
    "",
    "/**",
    " * The RSQL expression `build` makes from type `N`'s paths, unencoded: every value quoted, so input cannot end a",
    " * value early or add a clause.",
    " */",
    "export const filterFor = <N extends ApiTypeName>(type: N, build: (paths: FilterPaths<N>) => Filter<NoInfer<N>>): string =>",
    "  filterWith(NODES[type].filters(), build);",
    "",
  ].join("\n");
};
