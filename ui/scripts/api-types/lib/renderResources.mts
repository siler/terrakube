// Renders the committed generated module: the exported model JSON in, the prettier-formatted apiResources.ts source out.
// Formatting resolves against the committed path, so writing elsewhere cannot silently drop the repo's Prettier config.
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import * as prettier from "prettier";
import { emitResources } from "./emitResources.mts";
import { readModel, type ModelJson } from "./modelJson.mts";

const generatedPath = resolve(dirname(fileURLToPath(import.meta.url)), "../../../src/domain/generated/apiResources.ts");

const header = [
  "// Generated by ui/scripts/api-types/generate.mts from src/domain/generated/resource-model.json, which the API's ResourceModelExportTest writes. Do not edit.",
  "// Nullability, optionality and requiredness are decided in that export from the entities, their annotations and the database schema.",
];

export const renderResources = async (json: ModelJson): Promise<string> => {
  const options = (await prettier.resolveConfig(generatedPath)) ?? {};
  return prettier.format(emitResources(readModel(json), header), { ...options, filepath: generatedPath });
};
